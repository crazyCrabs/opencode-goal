{
  "name": "@crazycrabs/opencode-goal",
  "version": "0.1.0",
  "description": "Persistent autonomous goals for opencode. Event-sourced goal state (DSH-style) with safety guardrails (pi-goal-style): round limits, token budgets, no-progress detection, stale-turn guards.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "bun run build:server && bun run build:tui && tsc -p tsconfig.build.json",
    "build:server": "bun build ./src/index.ts --outdir dist --target bun",
    "build:tui": "bun build ./src/tui.tsx --outdir dist --target bun --external solid-js --external '@opentui/*'",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": ["opencode", "plugin", "goal", "autonomous", "agent"],
  "license": "MIT",
  "devDependencies": {
    "@opencode/plugin": "2.0.12",
    "@opentui/solid": "^0.5.11",
    "@types/node": "^22.13.9",
    "solid-js": "^1.9.15",
    "typescript": "^5.8.2"
  }
}