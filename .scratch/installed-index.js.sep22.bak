    waitUntil: goal.waitUntil,
    waitReason: goal.waitReason
  };
}
var DIRECT_TOOL_OPTIONS = { codemode: false };
function requireString(args, field) {
  const value = args[field];
  if (typeof value !== "string" || value.trim().length === 0) {
    throw new GoalError("GOAL_INVALID_EDIT", `${field} must be a non-empty string`);
  }
  return value;
}
function optionalString(args, field) {
  const value = args[field];
  if (value === undefined || value === null)
    return;
  if (typeof value !== "string") {
    throw new GoalError("GOAL_INVALID_EDIT", `${field} must be a string when present`);
  }
  return value;
}
function requirePositiveInteger(args, field) {
  const value = args[field];
  if (typeof value !== "number" || !Number.isSafeInteger(value) || value < 1) {
    throw new GoalError("GOAL_INVALID_EDIT", `${field} must be a positive safe integer`);
  }
  return value;
}
function optionalNumber(args, field) {
  const value = args[field];
  if (value === undefined || value === null)
    return;
  if (typeof value !== "number" || !Number.isFinite(value) || value < 0) {
    throw new GoalError("GOAL_INVALID_EDIT", `${field} must be a non-negative number when present`);
  }
  return value;
}
var UPDATE_ACTIONS = ["complete", "blocked", "pause", "resume", "edit"];
function goalTools(root, getStore) {
  const store = () => getStore(root);
  return [
    {
      name: "get_goal",
      description: "Read the current goal of this project, including its exact id/revision, objective, phase, rounds, round limit, token budget, usage, and whether a continuation is armed. Call this before update_goal.",
      options: DIRECT_TOOL_OPTIONS,
      input: {
        type: "object",
        properties: {},
        additionalProperties: false
      },
      async execute() {
        return { content: JSON.stringify(goalValue(store().view())) };
      }
    },
    {
      name: "create_goal",
      description: "Create one persisted completion goal for the current project when the current task is a long-running objective that should continue across autonomous rounds. Replaces a completed goal; a non-complete goal must be cleared first. Starts autonomous continuation (rounds, guarded by the round cap).",
      options: DIRECT_TOOL_OPTIONS,
      input: {
        type: "object",
        properties: {
          objective: { type: "string", description: "The concrete completion objective." },
          max_goal_rounds: {
            type: "integer",
            description: "Optional positive integer limit on automatic continuation rounds (default 25)."
          },
          token_budget: {
            type: "number",
            description: "Optional total token budget; continuation stops when provider-reported usage reaches it (0 = unlimited)."
          }
        },
        required: ["objective"],
        additionalProperties: false
      },
      async execute(rawArgs) {
        const args = rawArgs ?? {};
        const view = store().create(requireString(args, "objective"), optionalNumber(args, "max_goal_rounds") ?? 25, optionalNumber(args, "token_budget") ?? 0);
        return { content: JSON.stringify(goalValue(view)) };
      }
    },
    {
      name: "update_goal",
      description: "Update the exact current goal revision. Actions: complete (mark achieved with evidence), blocked (report a true impasse), pause, resume, edit (objective and/or max_goal_rounds). Requires the exact goal_id and revision returned by get_goal; stale refs are rejected.",
      options: DIRECT_TOOL_OPTIONS,
      input: {
        type: "object",
        properties: {
          goal_id: { type: "string", description: "Exact id returned by get_goal." },
          revision: { type: "integer", description: "Exact positive revision returned by get_goal." },
          action: {
            type: "string",
            enum: [...UPDATE_ACTIONS],
            description: "The operation to perform."
          },
          objective: { type: "string", description: "Replacement objective; valid only with action edit." },
          max_goal_rounds: { type: "integer", description: "Replacement round cap; valid only with action edit." },
          summary: {
            type: "string",
            description: "Completion evidence summary; required with action complete."
          },
          blocked_reason: {
            type: "string",
            description: "Concrete blocking condition; required with action blocked."
          }
        },
        required: ["goal_id", "revision", "action"],
        additionalProperties: false
      },
      async execute(rawArgs) {
        const args = rawArgs ?? {};
        const ref = goalRef(requireString(args, "goal_id"), requirePositiveInteger(args, "revision"));
        const action = requireString(args, "action");
        if (!UPDATE_ACTIONS.includes(action)) {
          throw new GoalError("GOAL_INVALID_EDIT", `unknown action ${action}`);
        }
        switch (action) {
          case "edit": {
            const objective = optionalString(args, "objective");
            const maxGoalRounds = optionalNumber(args, "max_goal_rounds");
            if (objective === undefined && maxGoalRounds === undefined) {
              throw new GoalError("GOAL_INVALID_EDIT", "edit requires objective and/or max_goal_rounds");
            }
            return {
              content: JSON.stringify(goalValue(store().edit(ref, objective, maxGoalRounds)))
            };
          }
          case "pause":
            return { content: JSON.stringify(goalValue(store().pause(ref))) };
          case "resume":
            return { content: JSON.stringify(goalValue(store().resume(ref))) };
          case "complete": {
            const summary = optionalString(args, "summary");
            if (summary === undefined || summary.trim().length === 0) {
              throw new GoalError("GOAL_INVALID_EDIT", "complete requires a summary of completion evidence");
            }
            if (summary.toLowerCase().includes("not complete") || summary.toLowerCase().includes("still fail")) {
              throw new GoalError("GOAL_INVALID_EDIT", "completion summary contradicts completion");
            }
            return { content: JSON.stringify(goalValue(store().complete(ref))) };
          }
          case "blocked": {
            const blockedReason = optionalString(args, "blocked_reason");
            if (blockedReason === undefined || blockedReason.trim().length === 0) {
              throw new GoalError("GOAL_INVALID_EDIT", "blocked requires a concrete blocked_reason");
            }
            return {
              content: JSON.stringify(goalValue(store().block(ref, { code: "model-reported", message: blockedReason.trim() })))
            };
          }
          default:
            throw new GoalError("GOAL_INVALID_EDIT", `unknown action ${action}`);
        }
      }
    },
    {
      name: "goal_wait",
      description: "Wait for an external event (e.g. a monitor, review, or CI run). Suppresses automatic continuation until the optional deadline (resume_after_ms) or until other non-goal work arrives. Use only after arranging an external wake source.",
      options: DIRECT_TOOL_OPTIONS,
      input: {
        type: "object",
        properties: {
          goal_id: { type: "string", description: "Exact id returned by get_goal." },
          revision: { type: "integer", description: "Exact positive revision returned by get_goal." },
          reason: { type: "string", description: "Why the goal is waiting (1-1000 chars)." },
          resume_after_ms: {
            type: "number",
            description: "Optional safety wake-up deadline in ms (clamped to at least 10s)."
          }
        },
        required: ["goal_id", "revision", "reason"],
        additionalProperties: false
      },
      async execute(rawArgs) {
        const args = rawArgs ?? {};
        const ref = goalRef(requireString(args, "goal_id"), requirePositiveInteger(args, "revision"));
        return {
          content: JSON.stringify(goalValue(store().wait(ref, requireString(args, "reason"), optionalNumber(args, "resume_after_ms"))))
        };
      }
    }
  ];
}

// src/index.ts
var OpenCodeGoalPlugin = {
  id: "opencode-goal",
  async setup(ctx) {
    const root = ctx.location.directory;
    const stores = new Map;
    const getStore = (dir) => {
      const key = dir.length > 0 ? dir : root;
      let store = stores.get(key);
      if (store === undefined) {
        store = new GoalStore(key);
        stores.set(key, store);
      }
      return store;
    };
    const log = (message, extra) => {
      console.log(`[opencode-goal] ${message}`, extra ?? "");
    };
    const sessionDirectories = new Map;
    const childSessions = new Set;
    const normalizePath = (value) => value.replace(/\//g, "\\").toLowerCase();
    const ownsDirectory = (directory) => {
      const rootPath = normalizePath(root);
      const dir = normalizePath(directory);
      return dir === rootPath || dir.startsWith(`${rootPath}\\`);
    };
    const rememberSession = (sessionID, directory, parentID) => {
      if (directory !== undefined && directory.length > 0)
        sessionDirectories.set(sessionID, directory);
      if (typeof parentID === "string" && parentID.length > 0)
        childSessions.add(sessionID);
    };
    const resolveTurnSession = async (sessionID, envelopeDirectory) => {
      if (childSessions.has(sessionID))
        return;
      let directory = sessionDirectories.get(sessionID);
      if (directory === undefined) {
        try {
          const info = await ctx.session.get({ sessionID });
          if (info === undefined)
            return;
          const infoDirectory = info.directory ?? info.location?.directory;
          rememberSession(sessionID, infoDirectory, info.parentID);
          if (childSessions.has(sessionID))
            return;
          directory = infoDirectory;
        } catch {
          return;
        }
      }
      if (directory === undefined || directory.length === 0)
        directory = envelopeDirectory;
      if (directory === undefined || !ownsDirectory(directory))
        return;
      return directory;
    };
    const driver = new GoalDriver({
      getStore,
      session: ctx.session,
      log
    });
    driver.setDirectory(root);
    getStore(root);
    log("plugin initialized", { root });
    const tools = goalTools(root, getStore);
    const toolRegistration = await ctx.tool.transform((editor) => {
      for (const tool of tools)
        editor.add(tool);
    });
    const systemHook = await ctx.session.hook("context", (event) => {
      const goal = getStore(root).view();
      if (goal === undefined || goal.phase !== "active")
        return;
      const budget = goal.tokenBudget > 0 ? ` | budget ${goal.usage.inputTokens + goal.usage.outputTokens}/${goal.tokenBudget}` : "";
      event.system.push({
        type: "text",
        text: [
          `[opencode-goal] Active goal (round ${goal.roundsStarted + 1}/${goal.maxGoalRounds}${budget}): ${goal.objective}`,
          'Keep working toward this objective across turns. Call get_goal to inspect it, update_goal(action="complete") with evidence when achieved, update_goal(action="blocked") for a true impasse, or goal_wait while waiting on external events.'
        ].join(`
`)
      });
    });
    const controller = new AbortController;
    (async () => {
      try {
        for await (const event of ctx.event.subscribe({ signal: controller.signal })) {
          if (event.type === "session.idle") {
            const sessionID = event.data.sessionID;
            if (sessionID === undefined)
              continue;
            (async () => {
              const directory = await resolveTurnSession(sessionID, event.location?.directory);
              if (directory !== undefined)
                await driver.onSessionIdle(sessionID, directory);
            })();
          } else if (event.type === "session.created") {
            const entries = Array.isArray(event.data) ? event.data : [event.data];
            for (const entry of entries) {
              const sessionID = entry.sessionID ?? entry.info?.id;
              if (sessionID === undefined)
                continue;
              const parentID = entry.parentID ?? entry.info?.parentID;
              const directory = entry.location?.directory ?? entry.info?.directory ?? event.location?.directory ?? root;
              rememberSession(sessionID, directory, parentID);
              if (childSessions.has(sessionID))
                continue;
              if (!ownsDirectory(directory))
                continue;
              driver.onSessionCreated(sessionID, directory);
            }
          } else if (event.type === "session.execution.succeeded" || event.type === "session.execution.failed" || event.type === "session.execution.interrupted") {
            const sessionID = event.data.sessionID;
            if (sessionID === undefined)
              continue;
            const reason = event.type === "session.execution.interrupted" ? event.data.reason : undefined;
            (async () => {
              const directory = await resolveTurnSession(sessionID, event.location?.directory);
              if (directory !== undefined)
                await driver.onTurnFinished(sessionID, directory, reason);
            })();
          } else if (event.type === "session.deleted") {
            const sessionID = event.data.sessionID;
            if (sessionID === undefined)
              continue;
            sessionDirectories.delete(sessionID);
            childSessions.delete(sessionID);
            driver.forget(sessionID);
          }
        }
      } catch {}
    })();
    return async () => {
      controller.abort();
      await systemHook.dispose();
      await toolRegistration.dispose();
    };
  }
};
var src_default = OpenCodeGoalPlugin;
export {
  src_default as default,
  OpenCodeGoalPlugin
};
